APP_NAME=SALONO
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# JWT (php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_salono
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
# Définir un mot de passe Redis en production (requirepass)
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@salono.ci"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOGO_URL=

# OTP SMS (Twilio). Laisser SMS_OTP_ENABLED=false tant que non branché : aucun SMS envoyé.
SMS_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS notifications (RDV tracking, rappels, bienvenue salon)
SMS_NOTIFICATIONS_ENABLED=false
# Plafonds : par salon / 24 h, par numéro destinataire / 24 h (tous salons), SMS de bienvenue / heure (global)
SMS_DAILY_LIMIT_PER_SALON=200
SMS_DAILY_LIMIT_PER_RECIPIENT=10
SMS_WELCOME_HOURLY_LIMIT=20

# Frontend Vue.js public (pages /booking/{slug} et /rdv/{token})
FRONTEND_URL=https://salono.ci

# Durée essai à l'inscription (jours, à partir de la date d'inscription)
SUBSCRIPTION_TRIAL_DAYS=7

# Simulation paiement abonnement salon (désactiver quand GeniusPay est actif)
SIMULATE_SUBSCRIPTION_PAYMENTS=false

# Proxies de confiance (IP/CIDR séparés par des virgules, ou * derrière un load balancer maîtrisé)
TRUSTED_PROXIES=

# Origines CORS autorisées (séparées par des virgules). Vide = toutes (déconseillé en production).
# Local : front Vite. Production : CORS_ALLOWED_ORIGINS=https://salono.ci,https://app.salono.ci
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Documentation Swagger (/api/documentation) : désactivée par défaut hors local
API_DOCS_ENABLED=false

# GeniusPay (dashboard > Paramètres > API). Le préfixe des clés choisit le mode : pk_sandbox_… / pk_live_…
GENIUSPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxxxx
GENIUSPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxx
# Secret du webhook {APP_URL}/api/v1/payment/webhook (affiché une seule fois à sa création)
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_xxxxxxxxxxxxxxxxxx
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
# Écart toléré sous le prix attendu (frais prélevés côté marchand), au-delà : vérification manuelle
GENIUSPAY_AMOUNT_TOLERANCE_PERCENT=8
# Durée de vie du lien de paiement si GeniusPay ne fournit pas expires_at, et plafond pris en compte
# pour le rejeu et la limite de 3 liens ouverts (minutes)
GENIUSPAY_CHECKOUT_TTL_MINUTES=30
# Passages de réconciliation (15 min) sur un remboursement annoncé non confirmé avant alerte
GENIUSPAY_REFUND_CHECK_MAX_ATTEMPTS=96
# File des traitements de paiement (le worker doit l'écouter : queue:work --queue=payments,default)
GENIUSPAY_QUEUE=payments
# Destinataire des alertes paiement (montant à vérifier, remboursement après activation)
PAYMENT_ALERT_EMAIL=

# Super admin (php artisan db:seed --class=SuperAdminSeeder)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@salono.ci
SUPER_ADMIN_PHONE=
# Obligatoire pour le seeder : 12 caractères minimum, jamais commité
SUPER_ADMIN_PASSWORD=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

