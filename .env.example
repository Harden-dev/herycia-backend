APP_NAME=SALONO
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# JWT (php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_salono
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
# Définir un mot de passe Redis en production (requirepass)
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@salono.ci"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOGO_URL=

# OTP SMS (Twilio). Laisser SMS_OTP_ENABLED=false tant que non branché : aucun SMS envoyé.
SMS_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS notifications (RDV tracking, rappels, bienvenue salon)
SMS_NOTIFICATIONS_ENABLED=false

# Frontend Vue.js public (pages /booking/{slug} et /rdv/{token})
FRONTEND_URL=https://salono.ci

# Durée essai à l'inscription (jours, à partir de la date d'inscription)
SUBSCRIPTION_TRIAL_DAYS=7

# Simulation paiement abonnement salon (désactiver quand Paystack est actif)
SIMULATE_SUBSCRIPTION_PAYMENTS=false

# Proxies de confiance (IP/CIDR séparés par des virgules, ou * derrière un load balancer maîtrisé)
TRUSTED_PROXIES=

# Origines CORS autorisées (séparées par des virgules). Vide = toutes (déconseillé en production)
CORS_ALLOWED_ORIGINS=https://salono.ci,https://app.salono.ci

# Documentation Swagger (/api/documentation) : désactivée par défaut hors local
API_DOCS_ENABLED=false

# Paystack (mode test)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=admin@salono.ci

# Super admin (php artisan db:seed --class=SuperAdminSeeder)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@salono.ci
SUPER_ADMIN_PHONE=
# Obligatoire pour le seeder : 12 caractères minimum, jamais commité
SUPER_ADMIN_PASSWORD=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

