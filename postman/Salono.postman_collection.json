    {
      "name": "08 — Booking public (sans auth)",
      "item": [
        {
          "name": "Get salon booking info",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/booking/{{salon_slug}}",
            "description": "Retourne salon + services + employees + booking_link wa.me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  if (j.data?.services?.[0]?.id) pm.environment.set('service_id', j.data.services[0].id);",
                "  if (j.data?.employees?.[0]?.id) pm.environment.set('user_id', j.data.employees[0].id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Create public booking",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/booking/create.json" } },
            "url": "{{base_url}}/booking/{{salon_slug}}",
            "description": "scheduled_at doit être dans le futur. Récupérer un créneau via GET booking ou bot."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const j = pm.response.json();",
                "  if (j.data?.id) pm.environment.set('appointment_id', j.data.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "09 — Webhook WhatsApp (public)",
      "item": [
        {
          "name": "Verify webhook (Meta)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/plain" }],
            "url": {
              "raw": "{{base_url}}/webhook/whatsapp?hub.mode=subscribe&hub.verify_token={{whatsapp_verify_token}}&hub.challenge=1158201444",
              "host": ["{{base_url}}"],
              "path": ["webhook", "whatsapp"],
              "query": [
                { "key": "hub.mode", "value": "subscribe" },
                { "key": "hub.verify_token", "value": "{{whatsapp_verify_token}}" },
                { "key": "hub.challenge", "value": "1158201444" }
              ]
            }
          }
        },
        {
          "name": "Incoming message — RDV slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Hub-Signature-256", "value": "{{whatsapp_hmac_signature}}", "description": "sha256=... calculé sur le body brut" }
            ],
            "body": { "mode": "file", "file": { "src": "payloads/webhook/meta-incoming-rdv.json" } },
            "url": "{{base_url}}/webhook/whatsapp",
            "description": "Si WHATSAPP_APP_SECRET vide et WHATSAPP_ENABLED=false, pas de HMAC requis. Sinon utiliser pre-request script pour signer."
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": [
                "const secret = pm.environment.get('whatsapp_app_secret');",
                "if (!secret) return;",
                "const body = pm.request.body.mode === 'raw' ? pm.request.body.raw : '';",
                "const crypto = require('crypto-js');",
                "const hash = crypto.HmacSHA256(body, secret).toString(crypto.enc.Hex);",
                "pm.request.headers.upsert({ key: 'X-Hub-Signature-256', value: 'sha256=' + hash });"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Incoming message — choose service (1)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "file", "file": { "src": "payloads/webhook/meta-incoming-choose-service.json" } },
            "url": "{{base_url}}/webhook/whatsapp"
          }
        },
        {
          "name": "Incoming message — confirm oui",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "file", "file": { "src": "payloads/webhook/meta-incoming-confirm-oui.json" } },
            "url": "{{base_url}}/webhook/whatsapp"
          }
        },
        {
