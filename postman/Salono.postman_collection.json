            }
          }]
        },
        {
          "name": "Create appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/appointments/create.json" } },
            "url": "{{base_url}}/v1/appointments"
          },
          "event": [{
            "listen": "test",
            "script": {
