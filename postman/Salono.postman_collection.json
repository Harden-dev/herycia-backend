              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Create service (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/services/create.json" } },
            "url": "{{base_url}}/v1/services"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
