          "name": "List appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/appointments?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["v1", "appointments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" },
                { "key": "date", "value": "2026-05-24", "disabled": true },
                { "key": "from", "value": "2026-05-01", "disabled": true },
                { "key": "to", "value": "2026-05-31", "disabled": true },
                { "key": "user_id", "value": "{{user_id}}", "disabled": true }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  if (j.data?.[0]?.id) pm.environment.set('appointment_id', j.data[0].id);",
