{
  "info": {
    "_postman_id": "salono-api-collection",
    "name": "Salono API",
    "description": "Collection Salono — Auth, Salon, CRUD métier, Booking public, Webhook WhatsApp.\n\nImport aussi `environment.local.json`.\n\nOrdre recommandé :\n1. Register ou Login → token auto-sauvegardé\n2. GET services / users pour remplir les UUID\n3. Clients → Appointments → Payments\n4. Booking public (sans token)\n5. Webhook WhatsApp (HMAC requis si WHATSAPP_APP_SECRET configuré)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" }
  ],
  "item": [
    {
      "name": "01 — Auth (public)",
      "item": [
        {
          "name": "Register salon",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "file",
              "file": { "src": "payloads/auth/register.json" }
            },
            "url": "{{base_url}}/v1/auth/register",
            "description": "Crée salon + admin + abonnement trial. Body : payloads/auth/register.json"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const j = pm.response.json();",
                "  if (j.data?.access_token) pm.environment.set('token', j.data.access_token);",
                "  if (j.data?.salon?.slug) pm.environment.set('salon_slug', j.data.salon.slug);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "file",
              "file": { "src": "payloads/auth/login.json" }
            },
            "url": "{{base_url}}/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  if (j.data?.access_token) pm.environment.set('token', j.data.access_token);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Verify OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/auth/verify-otp.json" } },
            "url": "{{base_url}}/v1/auth/verify-otp"
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/auth/resend-otp.json" } },
            "url": "{{base_url}}/v1/auth/resend-otp"
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/auth/forgot-password.json" } },
            "url": "{{base_url}}/v1/auth/forgot-password"
          }
        },
        {
          "name": "Verify reset code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/auth/verify-reset-code.json" } },
            "url": "{{base_url}}/v1/auth/verify-reset-code"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/auth/reset-password.json" } },
            "url": "{{base_url}}/v1/auth/reset-password"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "02 — Salon (admin)",
      "item": [
        {
          "name": "Get salon",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/v1/salon" }
        },
        {
          "name": "Update salon",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/salon/update.json" } },
            "url": "{{base_url}}/v1/salon"
          }
        },
        {
          "name": "Upload logo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "logo", "type": "file", "src": [] }]
            },
            "url": "{{base_url}}/v1/salon/logo",
            "description": "Sélectionner un fichier image (jpg/png) dans le champ logo."
          }
        }
      ]
    },
    {
      "name": "03 — Employés (admin)",
      "item": [
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/users?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["v1", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  if (j.data?.[0]?.id) pm.environment.set('user_id', j.data[0].id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Create stylist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/users/create-stylist.json" } },
            "url": "{{base_url}}/v1/users"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const j = pm.response.json();",
                "  if (j.data?.id) { pm.environment.set('employee_id', j.data.id); pm.environment.set('user_id', j.data.id); }",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Create receptionist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/users/create-receptionist.json" } },
            "url": "{{base_url}}/v1/users"
          }
        },
        {
          "name": "Get employee",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/v1/users/{{employee_id}}"
          }
        },
        {
          "name": "Update employee",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "file", "file": { "src": "payloads/users/update.json" } },
            "url": "{{base_url}}/v1/users/{{employee_id}}"
          }
        },
        {
          "name": "Deactivate employee",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/v1/users/{{employee_id}}"
          }
        }
      ]
    },
    {
